<%# Line-art illustration for each insurance scenario. Pass `n` (0, 1, 2). %>
<div class="scenario-art" aria-hidden="true">
  <svg viewBox="0 0 240 120" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id="sa-grad-<%= n %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#eaf2ff"/><stop offset="1" stop-color="#5b8eff"/></linearGradient>
    </defs>
    <g stroke="url(#sa-grad-<%= n %>)" stroke-width="1.6">
    <% if (n === 0) { %>
      <!-- Patent application refused after examination -->
      <rect x="74" y="16" width="64" height="86" rx="6"/>
      <path d="M86 32h40M86 42h40M86 52h30M86 62h36" opacity=".55"/>
      <circle cx="152" cy="74" r="16"/><path d="m164 86 14 14" stroke-width="3"/>
      <path d="M40 60h20M44 50l-8-6M44 70l-8 6" opacity=".45"/>
      <path d="M190 30h24M196 22v16" opacity=".35"/>
    </g>
      <g transform="rotate(-14 106 80)"><rect x="82" y="68" width="50" height="22" rx="4" stroke="#ff8a65" stroke-width="2"/><path d="m98 74 10 10m0-10-10 10M114 79h10" stroke="#ff8a65" stroke-width="2"/></g>
    <% } else if (n === 1) { %>
      <!-- Exporting firm sued abroad -->
      <path d="M18 92h120" opacity=".5"/>
      <rect x="26" y="58" width="44" height="30" rx="3"/><rect x="72" y="58" width="44" height="30" rx="3"/>
      <path d="M36 58v30M46 58v30M56 58v30M82 58v30M92 58v30M102 58v30" opacity=".4"/>
      <path d="M124 60c16-26 40-36 62-34" stroke-dasharray="3 5"/>
      <path d="m180 20 8 6-8 6" />
      <rect x="170" y="54" width="40" height="12" rx="3" transform="rotate(-30 190 60)"/>
      <path d="m186 70 18 26" stroke-width="3"/>
      <path d="M170 100h44" />
    </g>
      <g><circle cx="210" cy="26" r="13" stroke="#d6e6ff" stroke-width="1.4" stroke-dasharray="3 3"/><text x="210" y="30" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-size="11" font-weight="700" fill="#d6e6ff">US</text></g>
    <% } else { %>
      <!-- Research institute finds its patent being used -->
      <path d="M50 20h20M54 20v34L36 92a6 6 0 0 0 5 9h38a6 6 0 0 0 5-9L66 54V20"/>
      <path d="M44 78h32" opacity=".55"/><circle cx="54" cy="86" r="2"/><circle cx="64" cy="82" r="1.6"/>
      <rect x="112" y="26" width="52" height="68" rx="5"/>
      <path d="M122 40h32M122 50h32M122 60h22" opacity=".55"/>
      <circle cx="146" cy="78" r="7"/><path d="m142 78 3 3 5-6"/>
      <path d="M170 60h20" stroke-dasharray="3 4"/>
      <rect x="192" y="44" width="30" height="34" rx="4" opacity=".7"/>
    </g>
      <g><path d="M207 18 222 42h-30Z" stroke="#ffb49c" stroke-width="2"/><path d="M207 27v7M207 38v.5" stroke="#ffb49c" stroke-width="2.4"/></g>
    <% } %>
  </svg>
</div>
