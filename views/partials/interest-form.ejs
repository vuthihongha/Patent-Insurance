<%# "Register interest" form. Pass `id` (unique per page) and optional `fromTool`. %>
<% const f = t.interest; const fid = typeof id !== 'undefined' ? id : 'interest'; %>
<form class="interest-form" data-interest novalidate aria-label="<%= f.kicker %>">
  <div class="field-row">
    <div class="field">
      <label for="<%= fid %>-org"><%= f.org %> <span class="req" aria-hidden="true">*</span></label>
      <input id="<%= fid %>-org" name="org" type="text" autocomplete="organization" required maxlength="160" aria-describedby="<%= fid %>-org-err">
      <p class="field-error" id="<%= fid %>-org-err" data-error-for="org" hidden><%= f.errors.org %></p>
    </div>
    <div class="field">
      <label for="<%= fid %>-email"><%= f.email %> <span class="req" aria-hidden="true">*</span></label>
      <input id="<%= fid %>-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="160" aria-describedby="<%= fid %>-email-err">
      <p class="field-error" id="<%= fid %>-email-err" data-error-for="email" hidden><%= f.errors.email %></p>
    </div>
  </div>
  <div class="field-row">
    <div class="field">
      <label for="<%= fid %>-contact"><%= f.contact %> <span class="opt">(<%= f.optional %>)</span></label>
      <input id="<%= fid %>-contact" name="contact" type="text" autocomplete="name" maxlength="120">
    </div>
    <div class="field">
      <label for="<%= fid %>-type"><%= f.type %></label>
      <select id="<%= fid %>-type" name="type">
        <option value=""><%= f.choose %></option>
        <% f.types.forEach((o) => { %><option><%= o %></option><% }) %>
      </select>
    </div>
  </div>
  <div class="field">
    <label for="<%= fid %>-sector"><%= f.sector %></label>
    <select id="<%= fid %>-sector" name="sector">
      <option value=""><%= f.choose %></option>
      <% f.sectors.forEach((o) => { %><option><%= o %></option><% }) %>
    </select>
  </div>
  <fieldset class="field topics">
    <legend><%= f.topicsLabel %></legend>
    <% f.topics.forEach((o, i) => { %>
      <label class="check"><input type="checkbox" name="topics" value="<%= o %>" id="<%= fid %>-topic-<%= i %>" <% if (i === 0) { %>checked<% } %>><span><%= o %></span></label>
    <% }) %>
  </fieldset>
  <div class="field">
    <label for="<%= fid %>-message"><%= f.message %></label>
    <textarea id="<%= fid %>-message" name="message" rows="3" maxlength="1000"></textarea>
  </div>
  <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
  <label class="check consent">
    <input type="checkbox" name="consent" id="<%= fid %>-consent" aria-describedby="<%= fid %>-consent-err">
    <span><%= f.consent %> <a href="<%= pathFor('privacy') %>"><%= f.consentLink %></a>.</span>
  </label>
  <p class="field-error" id="<%= fid %>-consent-err" data-error-for="consent" hidden><%= f.errors.consent %></p>
  <% if (typeof fromTool !== 'undefined' && fromTool) { %><p class="muted small"><%= f.fromTool %></p><% } %>
  <div class="form-actions">
    <button class="btn btn-light" type="submit" data-label="<%= f.submit %>" data-sending="<%= f.sending %>"><%= f.submit %>
      <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></button>
  </div>
  <p class="form-status" role="status" data-status hidden></p>
  <p class="form-status is-error" role="alert" data-server-error hidden><%= f.errors.server %></p>
  <p class="form-success" role="status" data-success hidden><svg class="icon" aria-hidden="true"><use href="#i-check"/></svg><%= f.success %></p>
</form>
