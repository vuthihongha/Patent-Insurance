<%
  const metaTitle = (c && c.meta && c.meta.title) || (typeof title !== 'undefined' ? `${title} | ${t.siteName}` : t.siteName);
  const metaDesc = (c && c.meta && c.meta.description) || t.siteTagline;
%>
<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= metaTitle %></title>
  <meta name="description" content="<%= metaDesc %>">
  <meta name="theme-color" content="#030A1C">
  <meta name="color-scheme" content="dark">
  <% if (siteUrl) { %><link rel="canonical" href="<%= siteUrl + currentPath %>"><% } %>
  <% Object.entries(alternates).forEach(([l, href]) => { %>
  <link rel="alternate" hreflang="<%= l %>" href="<%= siteUrl + href %>">
  <% }) %>
  <link rel="alternate" hreflang="x-default" href="<%= siteUrl + alternates.vi %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= metaTitle %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:locale" content="<%= lang === 'vi' ? 'vi_VN' : 'en_US' %>">
  <% if (siteUrl) { %><meta property="og:url" content="<%= siteUrl + currentPath %>"><% } %>
  <meta property="og:image" content="<%= (siteUrl || '') + '/images/og-' + lang + '.png' %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= metaTitle %>">
  <meta name="twitter:description" content="<%= metaDesc %>">
  <meta name="twitter:image" content="<%= (siteUrl || '') + '/images/og-' + lang + '.png' %>">
  <link rel="icon" href="/images/mark.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/site.css">
  <% if (page.key === 'tool') { %><link rel="stylesheet" href="/css/tool.css"><% } %>
  <script>document.documentElement.classList.add('js')</script>
</head>
<body>
<%- include('icons') %>
<a class="skip-link" href="#main"><%= t.skipToContent %></a>
