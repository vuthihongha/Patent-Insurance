<% const title = t.nav[page.key] || t.comingSoon.title; %>
<%- include('../partials/head', { title }) %>
<%- include('../partials/header') %>

<main id="main">
  <section class="page-hero page-hero-full" aria-labelledby="page-title">
    <div class="glow glow-hero" aria-hidden="true"></div>
    <div class="container narrow center-text">
      <p class="kicker"><%= title %></p>
      <h1 id="page-title" class="display display-sm"><%= t.comingSoon.title %></h1>
      <p class="hero-lead"><%= t.comingSoon.body %></p>
      <div class="btn-row center">
        <a class="btn btn-light" href="<%= pathFor('strategy') %>"><%= t.cta.strategy %>
          <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <a class="btn btn-ghost" href="<%= pathFor('home') %>"><%= t.cta.backHome %></a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
