  "lessons": {
    "kicker": "Lessons for Vietnam",
    "title": "Three <em>takeaways</em>",
    "items": [
      {
        "title": "Think holistically",
        "body": "Tie patent insurance to national IP and innovation policy."
      },
      {
        "title": "State opens the door",
        "body": "Early pilots and premium support, conditional and time-limited."
      },
      {
        "title": "Connect to finance",
        "body": "Link with IP-backed loans, credit guarantees and valuation."
      }
